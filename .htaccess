Options -Indexes
DirectoryIndex index.php login.php

# Block direct access to SQL / hidden files
<FilesMatch "\.(sql|md|log|ini)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(config|head|header|footer|auth_card)\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(self)"
</IfModule>

# Uncomment to force HTTPS (InfinityFree provides a free SSL certificate):
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
